# ============================================================
# MEDISCAN AI - ENVIRONMENT CONFIGURATION
# ============================================================

# App Settings
APP_NAME="MediScan AI"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True

# Security & Session
SECRET_KEY="mediscan-super-secure-secret-key-production-change-me-32chars!"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# For local development with zero dependencies:
DATABASE_URL="sqlite+aiosqlite:///./mediscan.db"
# For Docker / PostgreSQL production:
# DATABASE_URL="postgresql+asyncpg://mediscan_user:mediscan_password@localhost:5432/mediscan_db"

# Public Biomedical API Keys (Optional - APIs work without them)
NCBI_API_KEY=""
USER_EMAIL="researcher@mediscan.ai"
FDA_API_KEY=""

# AI / LLM Provider (Optional - defaults to grounded extractive offline mode)
# Options: "grounded_extractive", "openai", "anthropic"
MODEL_PROVIDER="grounded_extractive"
MODEL_NAME="gpt-4o-mini"
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
